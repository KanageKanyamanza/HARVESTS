doctype html
html(lang=lang)
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= subject
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #2d3748;
        background-color: #f7fafc;
        margin: 0;
        padding: 20px;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
        border-radius: 12px 12px 0 0;
      }
      .logo {
        width: 80px;
        height: 80px;
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .logo img {
        width: 50px;
        height: 50px;
        object-fit: contain;
      }
      .title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.025em;
      }
      .subtitle {
        font-size: 16px;
        opacity: 0.9;
        font-weight: 400;
      }
      .content {
        padding: 40px 30px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 20px;
      }
      .message {
        font-size: 16px;
        color: #4a5568;
        margin-bottom: 24px;
        line-height: 1.7;
      }
      .cta-container {
        text-align: center;
        margin: 32px 0;
      }
      .cta-button {
        display: inline-block;
        background-color: #16a34a;
        color: white;
        padding: 16px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.3);
        transition: all 0.2s ease;
      }
      .cta-button:hover {
        background-color: #15803d;
        transform: translateY(-1px);
        box-shadow: 0 6px 8px -1px rgba(22, 163, 74, 0.4);
      }
      .warning {
        background-color: #fff5cd;
        border: 1px solid #f6e05e;
        border-radius: 8px;
        padding: 20px;
        margin: 24px 0;
        border-left: 4px solid #d69e2e;
      }
      .warning-title {
        color: #744210;
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
      }
      .warning-title:before {
        content: '⚠️';
        margin-right: 8px;
      }
      .warning-text {
        color: #744210;
        font-size: 14px;
        line-height: 1.5;
      }
      .security {
        background-color: #ebf8ff;
        border: 1px solid #90cdf4;
        border-radius: 8px;
        padding: 20px;
        margin: 24px 0;
        border-left: 4px solid #3182ce;
      }
      .security-title {
        color: #2c5282;
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
      }
      .security-title:before {
        content: '🔒';
        margin-right: 8px;
      }
      .security-text {
        color: #2c5282;
        font-size: 14px;
        line-height: 1.5;
      }
      .security-tips {
        background-color: #f7fafc;
        border-radius: 8px;
        padding: 16px;
        margin: 32px 0;
      }
      .security-tips h3 {
        color: #2d3748;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 16px;
        text-align: center;
      }
      .security-tips ul {
        list-style: none;
        padding: 0;
      }
      .security-tips li {
        color: #4a5568;
        font-size: 15px;
        margin-bottom: 12px;
        padding-left: 24px;
        position: relative;
      }
      .security-tips li:before {
        content: '🔑';
        position: absolute;
        left: 0;
        font-size: 16px;
      }
      .link-fallback {
        background-color: #edf2f7;
        border-radius: 6px;
        padding: 16px;
        margin: 20px 0;
        word-break: break-all;
        font-size: 14px;
        color: #4a5568;
        font-family: monospace;
      }
      .footer {
        background-color: #1f2937;
        color: #ffffff;
        padding: 30px;
        text-align: center;
        font-size: 14px;
        line-height: 1.6;
        border-radius: 0 0 12px 12px;
      }
      .footer-brand {
        color: #ffffff;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .footer-contact {
        margin: 12px 0;
      }
      .footer-contact a {
        color: #16a34a;
        text-decoration: none;
      }
      .footer-contact a:hover {
        text-decoration: underline;
      }
      @media (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }
        .header, .footer {
            border-radius: 0;
        }
        .header, .content, .footer {
          padding: 20px;
        }
        .title {
          font-size: 24px;
        }
        .logo {
          width: 60px;
          height: 60px;
          font-size: 24px;
        }
      }
  body
    .email-container
      .header
        .logo
          img(src=logoUrl, alt=t('email.common.logo_alt'), style='width: 50px; height: 50px; object-fit: contain;')
        .title= t('email.password_reset.title')
        .subtitle= t('email.password_reset.subtitle')

      .content
        .greeting= t('email.password_reset.greeting', { firstName })

        .message
          p= t('email.password_reset.intro')

        .message
          p= t('email.password_reset.prompt')

        .cta-container
          a.cta-button(href=url)= t('email.password_reset.cta')

        .warning
          .warning-title= t('email.password_reset.warning_title')
          .warning-text= t('email.password_reset.warning_text')

        .security
          .security-title= t('email.password_reset.security_title')
          .security-text= t('email.password_reset.security_text')

        .link-fallback
          = t('email.common.link_fallback')
          br
          | #{url}

        .security-tips
          h3= t('email.password_reset.tips_title')
          ul
            each item in t('email.password_reset.tips')
              li= item

        .message
          p= t('email.password_reset.support')

      .footer
        .footer-brand 🌱 Harvests
        .footer-contact
          | #{t('email.common.footer_tagline_security')}
        .footer-contact
          | #{t('email.common.footer_urgent_support')}
        .footer-contact
          | #{t('email.common.footer_phone')} 
          a(href='tel:+221788346969') +221 78 834 69 69
        .footer-contact
          | #{t('email.common.footer_email')} 
          a(href='mailto:contact@harvests.site') contact@harvests.site
        .footer-contact
          | #{t('email.common.footer_rights', { year })}

doctype html
html(lang='fr')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= subject
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #334155;
        background-color: #f8fafc;
        margin: 0;
        padding: 24px;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }
      .header {
        background-color: #ffffff;
        padding: 40px 30px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
      }
      .logo {
        width: 80px;
        height: 80px;
        background-color: #f8fafc;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        padding: 12px;
      }
      .logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .brand-name {
        font-size: 20px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.025em;
        text-transform: uppercase;
      }
      .content {
        padding: 40px 32px;
        background-color: #ffffff;
      }
      .greeting {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 24px;
      }
      .message {
        font-size: 15px;
        color: #475569;
        margin-bottom: 24px;
        line-height: 1.8;
      }
      .message p {
        margin-bottom: 16px;
      }
      .message a {
          color: #10b981;
          font-weight: 600;
          text-decoration: underline;
      }
      .signature {
        margin-top: 40px;
        padding-top: 24px;
        border-top: 1px solid #f1f5f9;
        font-size: 14px;
        color: #64748b;
      }
      .signature-name {
        font-weight: 700;
        color: #0f172a;
      }
      .footer {
        background-color: #f8fafc;
        color: #94a3b8;
        padding: 32px;
        text-align: center;
        font-size: 12px;
        line-height: 1.6;
        border-top: 1px solid #e2e8f0;
      }
      .footer-links {
        margin-bottom: 16px;
      }
      .footer-links a {
        color: #64748b;
        text-decoration: none;
        margin: 0 10px;
        font-weight: 600;
      }
      .footer-contact {
        margin-bottom: 8px;
      }
      @media (max-width: 600px) {
        body { padding: 12px; }
        .email-container { border-radius: 0; border: none; }
        .header, .content, .footer { padding: 24px 20px; }
        .logo { width: 60px; height: 60px; }
      }
  body
    .email-container
      .header
        .logo
          img(src=logoUrl, alt='Harvests Logo')
        .brand-name HARVESTS
      
      .content
        .greeting Bonjour #{firstName},
        
        .message
          //- Here we render the HTML content passed from the composer
          //- Pug unescaped interpolation !{} is used for the HTML message
          div !{content}
        
        .signature
          p Cordialement,
          p.signature-name L'équipe HARVESTS
      
      .footer
        .footer-links
          a(href=`${url}/about`) À PROPOS
          span |
          a(href=`${url}/contact`) CONTACT
          span |
          a(href=`${url}/privacy`) CONFIDENTIALITÉ
        
        .footer-contact
          | HARVESTS Sénégal - Connectons l'Afrique à travers l'agriculture
        
        .footer-contact
          | Questions ? 📞 +221 77 197 07 13 | 📧 contact@harvests.site
        
        div
          | &copy; #{new Date().getFullYear()} Harvests. Tous droits réservés.

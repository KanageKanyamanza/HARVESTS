doctype html
html(lang=lang)
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= t('email.order_confirmation.page_title')
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #2d3748;
        background-color: #f7fafc;
        margin: 0;
        padding: 20px;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
        border-radius: 12px 12px 0 0;
      }
      .logo {
        width: 120px;
        height: 120px;
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 10px;
      }
      .logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.025em;
      }
      .subtitle {
        font-size: 16px;
        opacity: 0.9;
        font-weight: 400;
      }
      .content {
        padding: 40px 30px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 20px;
      }
      .message {
        font-size: 16px;
        color: #4a5568;
        margin-bottom: 24px;
        line-height: 1.7;
      }
      .cta-container {
        text-align: center;
        margin: 32px 0;
      }
      .cta-button {
        display: inline-block;
        background-color: #16a34a;
        color: white;
        padding: 16px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.3);
        transition: all 0.2s ease;
      }
      .order-summary {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 24px;
        margin: 24px 0;
      }
      .order-title {
        color: #1e293b;
        font-weight: 600;
        font-size: 18px;
        margin-bottom: 16px;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 8px;
      }
      .order-number {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 12px;
      }
      .order-details {
        width: 100%;
        border-collapse: collapse;
      }
      .order-details td {
        padding: 8px 0;
        border-bottom: 1px solid #e2e8f0;
        color: #4a5568;
      }
      .order-details tr:last-child td {
        border-bottom: none;
      }
      .total-row td {
        font-weight: 700;
        color: #16a34a;
        font-size: 18px;
        padding-top: 16px;
      }
      .footer {
        background-color: #1f2937;
        color: #ffffff;
        padding: 30px;
        text-align: center;
        font-size: 14px;
        line-height: 1.6;
        border-radius: 0 0 12px 12px;
      }
      .footer-brand {
        color: #ffffff;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .footer-contact {
        margin: 12px 0;
      }
      .footer-contact a {
        color: #16a34a;
        text-decoration: none;
      }
      .footer-contact a:hover {
        text-decoration: underline;
      }
      @media (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }
        .header, .footer {
            border-radius: 0;
        }
        .header, .content, .footer {
          padding: 20px;
        }
        .title {
          font-size: 24px;
        }
        .logo {
          width: 100px;
          height: 100px;
          padding: 8px;
        }
      }
  body
    - const items = (order && order.items && order.items.length ? order.items : (order && order.products)) || []
    - const currency = (order && order.currency) || 'FCFA'
    .email-container
      .header
        .logo
          img(src=logoUrl, alt=t('email.common.logo_alt'))
        .title= t('email.order_confirmation.title')
        .subtitle= t('email.order_confirmation.subtitle')
      
      .content
        .greeting= t('email.order_confirmation.greeting', { firstName })
        
        .message
          p= t('email.order_confirmation.intro')
        
        .order-summary
          .order-title= t('email.order_confirmation.order_title')
          if order && order.orderNumber
            .order-number= order.orderNumber
          table.order-details
            if items.length
              each item in items
                - const snapshot = item.productSnapshot || item.product || {}
                - const rawName = item.name || snapshot.name
                - const name = typeof rawName === 'string' ? rawName : (rawName && (rawName[lang] || rawName.fr)) || t('email.order_confirmation.product_fallback')
                - const lineTotal = item.totalPrice !== undefined ? item.totalPrice : (item.price !== undefined ? item.price : (item.unitPrice || 0))
                tr
                  td #{name} x #{item.quantity || 1}
                  td(style="text-align: right;") #{lineTotal} #{item.currency || currency}
            else
              tr
                td(colspan="2")= t('email.order_confirmation.details_unavailable')
            
            tr.total-row
              td= t('email.order_confirmation.total')
              td(style="text-align: right;") #{order && order.total !== undefined ? order.total : (order && order.totalAmount) || 0} #{currency}
        
        .cta-container
          a.cta-button(href=url + '/dashboard/orders')= t('email.order_confirmation.cta')
        
        .message
          p= t('email.order_confirmation.closing')
      
      .footer
        .footer-brand 🌱 Harvests
        .footer-contact
          | #{t('email.common.footer_tagline')}
        .footer-contact
          | #{t('email.common.footer_questions')}
        .footer-contact
          | #{t('email.common.footer_phone')} 
          a(href='tel:+221788346969') +221 78 834 69 69
        .footer-contact
          | #{t('email.common.footer_email')} 
          a(href='mailto:contact@harvests.site') contact@harvests.site
        .footer-contact
          | #{t('email.common.footer_rights', { year })}
